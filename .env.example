# Copy to .env and fill in. docker-compose reads this automatically.

# Which LLM the agent uses: claude (default) | openai | openrouter | mistral | mock
# Use `mock` to run the whole stack with NO API key and no cost — the agents
# still call the real MCP tools on both servers and return live data.
LLM_PROVIDER=claude

# Optional: override the model id for the chosen provider.
# claude     -> claude-opus-4-8 (default)
# openai     -> gpt-4o (default)
# openrouter -> openai/gpt-4o-mini (default; any tool-capable OpenRouter model id)
# mistral    -> mistral-large-latest (default)
LLM_MODEL=

# Provide the key matching LLM_PROVIDER (leave the others blank, none for mock).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OpenRouter — one key, hundreds of models (https://openrouter.ai/keys).
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# Host ports (containers always use these ports internally).
# Override only if a port is already taken on your machine.
ASAP_API_PORT=8021      # ASAP API      — orchestration (desired/actual)
CVC_API_PORT=8022       # CVC API       — car gateway / telemetry
REDBEND_API_PORT=8023   # Redbend API   — OTA (FOTA/SOTA) + activation execution
DATALAKE_API_PORT=8024  # Datalake API  — massive connected-services analytics
ASAP_MCP_PORT=8011      # ASAP MCP server
CVC_MCP_PORT=8012       # CVC MCP server
REDBEND_MCP_PORT=8013   # Redbend MCP server
DATALAKE_MCP_PORT=8014  # Datalake MCP server
WEB_PORT=8002           # Web chat UI

# Which MCP servers the agent connects to (comma-separated). The defaults below
# match the compose service names; you rarely need to change this.
# For LOCAL (non-docker) runs use:
#   MCP_SERVER_URLS=http://localhost:8011/mcp,http://localhost:8012/mcp,http://localhost:8013/mcp,http://localhost:8014/mcp
